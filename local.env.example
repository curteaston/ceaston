# Copy this file to .local/local.env for local development.
# The .local directory is gitignored, so real secrets stay out of commits.

# Office 365 email/calendar integration
MS_CLIENT_ID=your-microsoft-entra-application-client-id
MS_CLIENT_SECRET=your-microsoft-entra-client-secret-value
APP_BASE_URL=http://localhost:3001

# Optional local settings
# ANTHROPIC_API_KEY=your-anthropic-api-key
# APP_PASSWORD=choose-a-local-login-password
# API_KEY=choose-a-local-automation-api-key

# Twilio click-to-dial browser mode. Configure your TwiML App voice request URL as:
# https://your-public-crm-host/api/dialer/twiml. Twilio cannot call a plain localhost URL.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your-twilio-api-key-secret
# TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15551234567
