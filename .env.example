# ── Twilio ────────────────────────────────────────────────────────────────────
# Found at: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio phone number to display as caller ID (E.164 format)
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Create an API Key at: Twilio Console > Account > API Keys & Tokens
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here

# Create a TwiML App at: Twilio Console > Voice > TwiML Apps
# Set its Request URL to: https://your-domain.com/api/voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GoHighLevel ───────────────────────────────────────────────────────────────
# Found at: GHL > Settings > Business Profile > API Key (or use a private integration)
GHL_API_KEY=your_ghl_api_key_here

# Found at: GHL > Settings > Business Profile > Location ID
GHL_LOCATION_ID=your_location_id_here

# Optional: your GHL user ID (for attributing notes to you)
GHL_USER_ID=your_user_id_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
