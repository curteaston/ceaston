# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # set to "production" on your live server

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# SQLite database file path (relative to project root)
DB_PATH=./dialer.db

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your frontend URL in production)
ALLOWED_ORIGINS=http://localhost:3000

# Full public URL of this server — used for Twilio webhook signature validation
# Example: https://yourapp.example.com
WEBHOOK_BASE_URL=http://localhost:3000

# ── Twilio (fallback — credentials are stored per-tenant in DB after setup) ───
# These are only used if a tenant has NOT configured their own credentials yet.
# Typically leave these blank once the setup page is used.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your_api_secret_here
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── GoHighLevel (fallback — same reasoning as Twilio above) ──────────────────
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_location_id_here
GHL_USER_ID=your_user_id_here
